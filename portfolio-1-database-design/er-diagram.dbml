Table teams {
  team_id int [pk, increment]
  team_name varchar(50) [not null, unique]
}

Table players {
  player_id int [pk, increment]
  team_id int [not null, ref: > teams.team_id]
  player_name varchar(80) [not null]
}

Table flags {
  flag_id int [pk, increment]
  team_id int [not null, ref: > teams.team_id, note: 'team that owns the flag']
  tick_no int [not null, note: '1 to 96']
  flag_hash char(64) [not null, unique, note: 'SHA-256 of the flag, never plaintext']
  created_at timestamptz [not null]
  expires_at timestamptz [not null]
  indexes {
    (team_id, tick_no) [unique]
  }
}

Table submissions {
  submission_id bigint [pk, increment]
  team_id int [not null, ref: > teams.team_id, note: 'attacking team']
  player_id int [not null, ref: > players.player_id]
  flag_id int [ref: > flags.flag_id, note: 'empty when the flag is invalid']
  submitted_at timestamptz [not null]
  result varchar(10) [not null, note: 'accepted, expired, own_flag, duplicate, invalid']
}
